# ============================================================
# DEVVERSE — Environment Variable Template
# ============================================================
#
# Copy this file to .env and fill in the values for your local
# development environment.
#
#   cp .env.example .env
#
# NEVER commit the .env file. It is listed in .gitignore.
# NEVER put real secrets, passwords, or connection strings in
# this example file.
# ============================================================


# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# TCP port the Express API server listens on.
# The Vite dev server proxies /api to this port.
PORT=5000

# Runtime environment: development | test | production
NODE_ENV=development

# Origin allowed by CORS middleware (the React Vite dev server).
# Change this if your frontend runs on a different port.
CLIENT_ORIGIN=http://localhost:5173


# ------------------------------------------------------------
# Database  (added in Prompt 17)
# ------------------------------------------------------------

# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/devverse
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devverse
MONGODB_URI=


# ------------------------------------------------------------
# Session / Auth  (added in Prompt 21)
# ------------------------------------------------------------

# Secret used to sign HttpOnly session cookies.
# Use a long random string (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
