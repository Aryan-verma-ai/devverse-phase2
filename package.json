{
  "name": "devverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "test:client": "npm run test:unit --workspace=client",
    "test:server": "npm test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
